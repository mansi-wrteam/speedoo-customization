{
  "name": "egrocer-nextjs",
  "version": "4.0.3",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/generator.js",
    "build": "next build",
    "postbuild": "npm run copy-standalone-assets",
    "copy-standalone-assets": "node scripts/copy-assets.js",
    "start": "cross-env PORT=8001 HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "patch-package",
    "typecheck": "next typegen && tsc --noEmit",
    "verify:types-only": "node scripts/verify-type-only.mjs",
    "verify:server-only": "node scripts/verify-server-only.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:ssr-content": "node scripts/check-ssr-content.mjs",
    "check:ssr-head": "node scripts/check-ssr-content.mjs --section=head",
    "check:concurrency": "node scripts/check-concurrency.mjs",
    "check:no-refetch": "node scripts/check-no-refetch.mjs",
    "check:hydration": "node scripts/check-hydration.mjs",
    "serve:out": "node scripts/serve-out.mjs",
    "check:persisted-choice": "node scripts/check-persisted-choice.mjs",
    "load:test": "node scripts/load-test.mjs",
    "load:soak": "node scripts/load-test.mjs --mode=soak --minutes=60",
    "check:deep-links": "node scripts/check-deep-links.mjs"
  },
  "dependencies": {
    "@paystack/inline-js": "^2.22.1",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slider": "^1.2.2",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-toggle": "^1.1.1",
    "@radix-ui/react-toggle-group": "^1.1.1",
    "@react-google-maps/api": "^2.20.8",
    "@reduxjs/toolkit": "^2.12.0",
    "@stripe/react-stripe-js": "^3.1.1",
    "@stripe/stripe-js": "^5.4.0",
    "@tanstack/react-query": "^5.90.16",
    "@types/leaflet": "^1.9.22",
    "axios": "^1.8.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.7",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "11.1.0",
    "fs-extra": "^11.3.5",
    "globby": "^14.1.0",
    "leaflet": "^1.9.4",
    "lodash": "^4.17.21",
    "lottie-react": "^2.4.2",
    "lucide-react": "^0.461.0",
    "next": "^16.3.6",
    "next-themes": "^0.4.4",
    "pusher-js": "^8.6.0",
    "react": "^19.3.0",
    "react-day-picker": "^8.10.1",
    "react-dom": "^19.3.0",
    "react-icons": "^5.3.0",
    "react-image-magnify": "^2.7.4",
    "react-leaflet": "^5.0.0",
    "react-loading-skeleton": "^3.5.0",
    "react-otp-input": "^3.1.1",
    "react-phone-input-2": "^2.15.1",
    "react-redux": "^9.3.0",
    "react-responsive": "^10.0.0",
    "react-share": "^5.3.0",
    "react-toastify": "^10.0.6",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "redux-thunk": "^3.1.0",
    "swiper": "^11.1.15",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "yet-another-react-lightbox": "^3.21.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "jsdom": "^26.1.0",
    "patch-package": "^8.0.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "react-image-magnify": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "react-day-picker": {
      "react": "$react"
    },
    "@radix-ui/react-dialog": {
      "react-remove-scroll": "2.7.2"
    }
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
